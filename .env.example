# ─── Database ──────────────────────────────────────────────────────
# For local dev: localhost:5433 (Docker) or localhost:5432 (native)
DATABASE_URL=postgresql://scouts_yp:changeme@localhost:5433/scouts_yp
DB_PASSWORD=changeme

# ─── API Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─── JWT Authentication ────────────────────────────────────────────
JWT_SECRET=your-secret-key-minimum-16-characters
JWT_REFRESH_SECRET=your-refresh-secret-minimum-16-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ─── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Docker-only: API connects to the 'postgres' service ──────────
# DATABASE_URL=postgresql://scouts_yp:${DB_PASSWORD}@postgres:5432/scouts_yp
