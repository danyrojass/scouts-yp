# Database
# Local dev: localhost:5433 (Docker PostgreSQL) or localhost:5432 (native)
DATABASE_URL=postgresql://scouts_yp:changeme@localhost:5433/scouts_yp
DB_PASSWORD=changeme

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# JWT
JWT_SECRET=your-secret-key-minimum-16-characters
JWT_REFRESH_SECRET=your-refresh-secret-minimum-16-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=debug
